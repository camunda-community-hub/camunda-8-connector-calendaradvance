<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <name>CalendarAdvance</name>
    <description>Calendar Advance</description>
    <groupId>org.camunda.connector</groupId>
    <artifactId>connector-calendar-advance</artifactId>
    <packaging>jar</packaging>
    <!-- 1.0.0 -->
    <!-- 1.1.0 Accept as Duration input a String or a list of String -->
    <!-- 1.2.0 Accept List of duration or Map of duration -->
    <!-- 1.2.1 Fix bug with duration 1 minute -->
    <!-- 1.3.0 Change artefact Id -->
    <!-- 1.3.1 Change artefact Id -->
    <!-- 1.3.2 Change artefact Id to org.camunda-->
    <!-- 1.3.3 Change code to org.camunda.connector -->
    <!-- 1.3.4 Fix bug in ListPeriods -->
    <!-- 1.4.0 Input "ErrorWhenNoDateFound" and "HolidayCalendarPolicy" -->
    <!-- 1.4.1 Reduce Jar size to 80 kb, and add preload calendar for test reason -->
    <version>1.4.1</version>
    <url>https://github.com/camunda-community-hub/camunda-8-connector-calendaradvance</url>

    <scm>
        <url>https://github.com/camunda-community-hub/camunda-8-connector-calendaradvance</url>
        <connection>scm:git:git@github.com:camunda-community-hub/camunda-8-connector-calendaradvance.git</connection>
        <developerConnection>scm:git:git@github.com:camunda-community-hub/camunda-8-connector-calendaradvance.git</developerConnection>
        <tag>HEAD</tag>
    </scm>
    <!-- Push the library to Maven -->
    <!-- Visit https://github.com/camunda-community-hub/community-action-maven-release -->
    <!-- This parent defines the profiles/plugins the release action needs (community-action-maven-release,
         camunda-repository, central-sonatype-publish, ...) and distributionManagement.
         Spring Boot's own version management is imported as a BOM below instead of as <parent>,
         since Maven only allows a single <parent>. -->
    <parent>
        <groupId>org.camunda.community</groupId>
        <artifactId>community-hub-release-parent</artifactId>
        <version>2.1.0</version>
        <relativePath />
    </parent>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>


        <!-- connector SDK version -->
        <!-- connector SDK version 8.8.7 / 8.7.8 -->
        <version.connector>8.8.7</version.connector>

        <version.spring-boot>3.4.4</version.spring-boot>

        <!-- external libraries -->
        <version.slf4j>2.0.18</version.slf4j>
        <version.jackson>2.17.0</version.jackson>
        <version.assertj>3.27.3</version.assertj>
        <version.junit-jupiter>5.12.1</version.junit-jupiter>
        <version.mockito>5.16.1</version.mockito>
        <java.version>23</java.version>
        <maven.compiler.source>23</maven.compiler.source>
        <maven.compiler.target>23</maven.compiler.target>
        <maven.compiler.release>23</maven.compiler.release>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>io.camunda.connector</groupId>
            <artifactId>connector-core</artifactId>
            <version>${version.connector}</version>
            <!--<scope>provided</scope>  -->
        </dependency>
        <dependency>
            <groupId>io.camunda.connector</groupId>
            <artifactId>connector-runtime-core</artifactId>
            <version>${version.connector}</version>
        </dependency>


        <dependency>
            <groupId>io.camunda.connector</groupId>
            <artifactId>element-template-generator-core</artifactId>
            <version>${version.connector}</version>
        </dependency>


        <dependency>
            <groupId>com.fasterxml.jackson.module</groupId>
            <artifactId>jackson-module-scala_2.13</artifactId>
            <version>2.17.0</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${version.slf4j}</version>
        </dependency>


        <!-- test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${version.junit-jupiter}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${version.mockito}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${version.assertj}</version>
            <scope>test</scope>
        </dependency>


        <!-- for testing connectors locally in bundle with runtime -->


        <dependency>
            <groupId>io.camunda.connector</groupId>
            <artifactId>spring-boot-starter-camunda-connectors</artifactId>
            <version>${version.connector}</version>
            <!--            <scope>test</scope> -->
        </dependency>

        <!-- to generate the element-template -->

        <dependency>
            <groupId>io.camunda.community</groupId>
            <artifactId>zeebe-cherry-runtime</artifactId>
            <version>3.5.2</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${version.spring-boot}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.camunda</groupId>
                <artifactId>camunda-bom</artifactId>
                <version>8.8.0</version>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>

        </resources>

        <plugins>
            <!-- banner.txt/application.yaml stay in target/classes (needed for local runs and
                 tests, and so this project's own banner wins over the one bundled in
                 zeebe-cherry-runtime), but are excluded from the packaged JARs below. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>banner.txt</exclude>
                        <exclude>application.yaml</exclude>
                        <exclude>application.yml</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <!-- "with-dependencies": a convenience jar for local use (upload to a Connector Runtime
                         or Cherry instance by hand). Those hosts already provide Spring Boot + the whole
                         Camunda connector/client/FEEL stack (and their own transitive libraries below), so
                         this jar excludes all of that by groupId and bundles nothing but this project's own
                         classes - this project's dependency:tree (scope=compile) shows no genuine extra
                         runtime library the host doesn't already supply.
                         shadedArtifactAttached MUST stay true here: with true, the shaded jar is attached
                         as a SEPARATE classified artifact and the main jar is left untouched; with false,
                         Shade instead REPLACES the main artifact's file with the fat jar (verified in sibling
                         projects: that produced a bogus "original-*.jar" backup and a bloated main jar - the
                         opposite of what we want). To keep this classified jar out of the Maven Central
                         release while still producing it on every local build, its execution is disabled
                         (phase=none) specifically under the "community-action-maven-release" profile further
                         down in this pom - that's the release-profile deploy.yml activates via
                         community-action-maven-release's "release-profile" input.
                         NOTE: a single blanket "*:*" exclude was tried first (see sibling projects) but also
                         strips out this project's OWN compiled classes - excluding by explicit groupId avoids
                         that trap entirely. -->
                    <execution>
                        <id>with-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedClassifierName>with-dependencies</shadedClassifierName>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <filters>
                                <filter>
                                    <artifact>io.camunda.connector:calendar-advance-function</artifact>
                                    <excludes>
                                        <exclude>banner.txt</exclude>
                                        <exclude>application.yaml</exclude>
                                        <exclude>application.yml</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <artifactSet>
                                <excludes>
                                    <!-- Camunda connector/client/FEEL stack -->
                                    <exclude>io.camunda.connector:*</exclude>
                                    <exclude>io.camunda:*</exclude>
                                    <exclude>org.camunda.feel:*</exclude>
                                    <exclude>org.camunda.bpm.model:*</exclude>
                                    <!-- Spring Boot / Spring Framework -->
                                    <exclude>org.springframework.boot:*</exclude>
                                    <exclude>org.springframework:*</exclude>
                                    <exclude>ch.qos.logback:*</exclude>
                                    <exclude>org.apache.logging.log4j:*</exclude>
                                    <exclude>org.slf4j:*</exclude>
                                    <exclude>org.apache.tomcat.embed:*</exclude>
                                    <exclude>io.micrometer:*</exclude>
                                    <exclude>org.hdrhistogram:*</exclude>
                                    <exclude>org.latencyutils:*</exclude>
                                    <exclude>org.hibernate.validator:*</exclude>
                                    <exclude>org.jboss.logging:*</exclude>
                                    <exclude>com.fasterxml:classmate</exclude>
                                    <exclude>org.yaml:*</exclude>
                                    <!-- gRPC / Netty (Zeebe gateway transport) -->
                                    <exclude>io.grpc:*</exclude>
                                    <exclude>io.netty:*</exclude>
                                    <exclude>io.opencensus:*</exclude>
                                    <exclude>io.perfmark:*</exclude>
                                    <exclude>com.google.protobuf:*</exclude>
                                    <exclude>com.google.api.grpc:*</exclude>
                                    <exclude>com.google.android:*</exclude>
                                    <!-- HTTP clients -->
                                    <exclude>org.apache.httpcomponents:*</exclude>
                                    <exclude>org.apache.httpcomponents.client5:*</exclude>
                                    <exclude>org.apache.httpcomponents.core5:*</exclude>
                                    <exclude>com.google.http-client:*</exclude>
                                    <exclude>commons-codec:*</exclude>
                                    <!-- Jackson -->
                                    <exclude>com.fasterxml.jackson.core:*</exclude>
                                    <exclude>com.fasterxml.jackson.dataformat:*</exclude>
                                    <exclude>com.fasterxml.jackson.datatype:*</exclude>
                                    <exclude>com.fasterxml.jackson.module:*</exclude>
                                    <exclude>com.fasterxml.uuid:*</exclude>
                                    <exclude>tools.jackson.core:*</exclude>
                                    <!-- Scala (FEEL engine) -->
                                    <exclude>org.scala-lang:*</exclude>
                                    <exclude>com.lihaoyi:*</exclude>
                                    <!-- Misc transitive libraries -->
                                    <exclude>com.auth0:*</exclude>
                                    <exclude>com.github.ben-manes.caffeine:*</exclude>
                                    <exclude>com.google.code.findbugs:*</exclude>
                                    <exclude>com.google.code.gson:*</exclude>
                                    <exclude>com.google.errorprone:*</exclude>
                                    <exclude>com.google.guava:*</exclude>
                                    <exclude>com.google.j2objc:*</exclude>
                                    <exclude>com.google.auth:*</exclude>
                                    <exclude>com.google.auto.value:*</exclude>
                                    <exclude>com.google.api:api-common</exclude>
                                    <exclude>javax.annotation:javax.annotation-api</exclude>
                                    <exclude>org.jetbrains:annotations</exclude>
                                    <exclude>com.thoughtworks.paranamer:*</exclude>
                                    <exclude>dev.failsafe:*</exclude>
                                    <exclude>jakarta.annotation:*</exclude>
                                    <exclude>jakarta.validation:*</exclude>
                                    <exclude>io.pebbletemplates:*</exclude>
                                    <exclude>net.steppschuh.markdowngenerator:*</exclude>
                                    <exclude>org.apache.commons:*</exclude>
                                    <exclude>org.bouncycastle:*</exclude>
                                    <exclude>org.checkerframework:*</exclude>
                                    <exclude>org.codehaus.mojo:animal-sniffer-annotations</exclude>
                                    <exclude>org.jspecify:*</exclude>
                                    <exclude>org.unbescape:*</exclude>
                                    <exclude>uk.co.jemos.podam:*</exclude>
                                </excludes>
                            </artifactSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Activated explicitly via "mvn -P camunda-consulting deploy" (see
             deploy-artifactory-camunda.yml). Personal/manual deploy path to Camunda's
             camunda-consulting Artifactory repo, using the current user's own personal Artifactory
             token instead of the community-hub's shared release credentials. Without it,
             distributionManagement and the maven-deploy-plugin skip both fall back to
             community-hub-release-parent's defaults (used by deploy.yml's Maven Central path). Kept
             profile-scoped, rather than unconditional, so that deploy.yml's own
             community-action-maven-release (Sonatype/Nexus release) - which runs a plain "mvn
             deploy" with no "-P camunda-consulting" - keeps using the parent's real Sonatype
             distributionManagement instead of being hijacked into deploying (and failing with 401,
             since that job has no Artifactory credentials) to camunda-consulting. -->
        <profile>
            <id>camunda-consulting</id>
            <distributionManagement>
                <repository>
                    <id>camunda-consulting</id>
                    <url>https://artifacts.camunda.com/artifactory/camunda-consulting/</url>
                </repository>
                <snapshotRepository>
                    <id>camunda-consulting-snapshots</id>
                    <url>https://artifacts.camunda.com/artifactory/camunda-consulting-snapshots/</url>
                </snapshotRepository>
            </distributionManagement>
            <build>
                <plugins>
                    <!-- community-hub-release-parent skips this plugin by default (releases normally go
                         through its camunda-repository/central-sonatype-publish profiles instead). -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-deploy-plugin</artifactId>
                        <configuration>
                            <skip>false</skip>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Same profile id as the one community-hub-release-parent defines and that deploy.yml
             activates via community-action-maven-release's "release-profile" input. Maven activates
             both the parent's and this child's profile together when that id is requested, so this
             just adds to the parent's release behavior: it disables the "with-dependencies" shade
             execution above for that build only, so the classified jar is never attached and never
             deployed to Maven Central - it stays a local-only convenience artifact produced by plain
             "mvn package"/"mvn install" runs. -->
        <profile>
            <id>community-action-maven-release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>with-dependencies</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <repositories>
        <repository>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
            <id>connectors</id>
            <name>Connectors Repository</name>
            <url>https://artifacts.camunda.com/artifactory/connectors/</url>
        </repository>

        <repository>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
            <id>connectors-snapshots</id>
            <name>Connectors Snapshot Repository</name>
            <url>https://artifacts.camunda.com/artifactory/connectors-snapshots/</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>connectors</id>
            <name>Connectors Repository</name>
            <url>https://artifacts.camunda.com/artifactory/connectors/</url>
        </pluginRepository>

        <pluginRepository>
            <id>connectors-snapshots</id>
            <name>Connectors Snapshot Repository</name>
            <url>https://artifacts.camunda.com/artifactory/connectors-snapshots/</url>
        </pluginRepository>
    </pluginRepositories>


</project>
